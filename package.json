{
  "name": "simple-chrome-extension-template",
  "version": "2.0.0",
  "description": "An opinionated Chrome extension template using Preact, HTM, Zustand, TypeScript, and Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "zip": "npm run build && cd dist && zip -r ../extension.zip .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,css,html}\"",
    "format:all": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@types/chrome": "^0.1.33",
    "@vitest/coverage-v8": "^4.1.6",
    "happy-dom": "^20.9.0",
    "prettier": "^3.6.1",
    "typescript": "^5.9.3",
    "vite": "^5.1.6",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "lucide": "^0.408.0",
    "preact": "^10.19.6",
    "zustand": "^5.0.6"
  },
  "type": "module"
}
