{
  "name": "simple-chrome-extension-template",
  "version": "1.0.0",
  "description": "A simple Chrome extension template using Preact, HTM, and Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "zip": "npm run build && cd dist && zip -r ../extension.zip .",
    "test": "echo 'No tests specified yet'"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "vite": "^5.1.6"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "preact": "^10.19.6"
  },
  "type": "module"
}
